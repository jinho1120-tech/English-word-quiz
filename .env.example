# Dedicated PostgreSQL database for English Word Quiz. Never reuse the family app database.
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Example: https://your-project.vercel.app
BETTER_AUTH_URL=

# Server-only pepper for child access-code HMAC. Generate with: openssl rand -base64 32
# Keep a secure backup; losing it invalidates all v2 child access codes.
CHILD_ACCESS_CODE_PEPPER=

# Set to false only after every child_profiles.access_code_hash has been migrated to v2.
ACCEPT_LEGACY_ACCESS_CODE_HASH=true

# Comma-separated exact email addresses allowed to access /super-admin.
# Server-only allowlist; never use a NEXT_PUBLIC_ prefix.
SUPER_ADMIN_EMAILS=

# Gmail SMTP for password-reset emails (use a Google App Password, never your normal Gmail password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Web Push notifications for parent app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
