# Dedicated PostgreSQL database for English Word Quiz. Never reuse the family app database.
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Example: https://your-project.vercel.app
BETTER_AUTH_URL=

# Resend transactional email (sender must use a verified domain in Resend)
RESEND_API_KEY=
# Example: English Word Quiz <no-reply@your-verified-domain.com>
RESEND_FROM_EMAIL=

GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
